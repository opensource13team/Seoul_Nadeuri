<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- 1. 최상단: 앱 헤더 (로고, 제목, 검색 버튼) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:paddingHorizontal="16dp"
            android:gravity="center_vertical">

            <!-- 좌측: 로고 이미지 (임시로 안드로이드 아이콘 사용) -->
            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@mipmap/ic_launcher" /> <!-- 나중에 디자인하신 보따리 로고로 교체! -->

            <!-- 좌측: 앱 이름 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/iv_logo"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:text="서울 나래"
                android:textColor="@color/point_green_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- 우측: 돋보기 아이콘 (클릭 시 검색 탭으로 이동) -->
            <ImageButton
                android:id="@+id/btn_top_search"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/text_dark" />
        </RelativeLayout>

        <!-- 2. 상단: 오토 롤링 배너 (Hero Carousel) -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vp_hero_banner"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="24dp" />

        <!-- 3. 중단: 퀵 필터 둥근 아이콘 5개 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:weightSum="5">

            <LinearLayout
                android:id="@+id/btn_filter_indoor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_search_bar"
                    android:backgroundTint="@color/bg_light_green"
                    android:gravity="center"
                    android:text="🏢"
                    android:textSize="26sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="실내"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_filter_outdoor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_search_bar"
                    android:backgroundTint="@color/bg_light_green"
                    android:gravity="center"
                    android:text="🌳"
                    android:textSize="26sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="야외"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_filter_relaxed"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_search_bar"
                    android:backgroundTint="@color/bg_light_green"
                    android:gravity="center"
                    android:text="🟢"
                    android:textSize="26sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="쾌적"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_filter_festival"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_search_bar"
                    android:backgroundTint="@color/bg_light_green"
                    android:gravity="center"
                    android:text="🎪"
                    android:textSize="26sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="축제"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_filter_wishlist"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_search_bar"
                    android:backgroundTint="#FFF9C4"
                    android:gravity="center"
                    android:text="⭐"
                    android:textSize="26sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="찜목록"
                    android:textColor="@color/text_dark"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 4. 중하단: AI 맞춤 추천 (세로 스크롤) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:text="✨ AI가 분석한 지금 뜨는 핫플"
            android:textColor="@color/text_dark"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_ai_recommend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>